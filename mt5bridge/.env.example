# mt5bridge config. Copy to mt5bridge/.env (gitignored) and fill ONLY if you
# need headless login. The default/safest flow needs NONE of these:
#
#   1. Open the MT5 desktop terminal.
#   2. Log into your REAL Admirals account by hand.
#   3. Run `python connect.py` — it attaches to the running terminal with NO
#      credentials in any file.
#
# Headless login (only on a dedicated VPS where MT5 runs unattended):
# MT5_LOGIN=12345678
# MT5_PASSWORD=
# MT5_SERVER=Admirals-Live        # EXACT server name from the MT5 login dialog

# Optional:
# MT5_SYMBOL=XAUUSD               # Admirals gold symbol; connect.py suggests if wrong
# MT5_PATH=C:\Program Files\Admirals MT5 Terminal\terminal64.exe  # if auto-detect fails
